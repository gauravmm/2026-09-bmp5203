  "gremlins.characters": {
    "2013": {
      "description": "en dash",
      "level": "warning"
    },
    "2018": {
      "description": "left single quotation mark",
      "level": "warning"
    },
    "2019": {
      "description": "right single quotation mark",
      "level": "warning"
    },
    "2029": {
      "zeroWidth": true,
      "description": "paragraph separator",
      "level": "error"
    },
